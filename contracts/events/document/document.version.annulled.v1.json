{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/events/document/document.version.annulled.v1.json",
  "title": "DocumentVersionAnnulledV1",
  "description": "Версия документа аннулирована — аннулирование — новой записью; подписи прежней версии остаются при ней (AD-12).",
  "type": "object",
  "properties": {
    "document_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
