{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/events/erp/erp.posting.responded.v1.json",
  "title": "ErpPostingRespondedV1",
  "description": "Ответ учётной системы — квитанция или ошибка 1С на исходящее сообщение; ось «учёт в 1С» меняется только по подтверждению (AD-30).",
  "type": "object",
  "properties": {
    "business_key": {
      "type": "string",
      "description": "Бизнес-ключ.",
      "maxLength": 256
    },
    "request_event_id": {
      "$ref": "../common/defs.v1.json#/definitions/uuid",
      "description": "Запись `erp.posting.requested`."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "accepted",
        "duplicate",
        "rejected"
      ],
      "description": "Итог."
    },
    "external_document_ref": {
      "type": "string",
      "description": "Документ 1С.",
      "maxLength": 128
    },
    "error_code": {
      "type": "string",
      "description": "Код ошибки из contracts/errors.yaml (например, `reference.not_found`).",
      "maxLength": 96
    },
    "error_message": {
      "type": "string",
      "maxLength": 4000,
      "description": "Текст ошибки внешней системы."
    },
    "resulting_status": {
      "$ref": "../common/defs.v1.json#/definitions/axis_erp_accounting",
      "description": "Статус учёта изделия после подтверждения."
    },
    "message_id": {
      "$ref": "../common/defs.v1.json#/definitions/uuid",
      "description": "Номер сообщения (`X-Message-Id`)."
    },
    "action": {
      "type": "string",
      "enum": [
        "accept_into_work",
        "warehouse_transfer",
        "scrap_transfer_rework",
        "scrap_transfer_writeoff",
        "scrap_transfer_reprocess",
        "return_to_supplier",
        "return_from_defect",
        "release",
        "inspection_result"
      ],
      "description": "Учётное действие сообщения."
    },
    "item_id": {
      "$ref": "../common/defs.v1.json#/definitions/item_id",
      "description": "Изделие — для оси «учёт в 1С» (AD-30)."
    },
    "lot_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
      "description": "Партия."
    },
    "receipt": {
      "type": "string",
      "maxLength": 64,
      "description": "Номер квитанции учётной системы; повтор с тем же номером сообщения возвращает ту же квитанцию."
    },
    "http_status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599,
      "description": "Код ответа HTTP учётной системы."
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "description": "Номер попытки отправки, на которую пришёл ответ."
    }
  },
  "required": [
    "business_key",
    "request_event_id",
    "outcome"
  ]
}
