{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/events/decision/decision.clean_point.assigned.v1.json",
  "title": "DecisionCleanPointAssignedV1",
  "description": "Изделие попало в «точку чистоты» (FR-49): после снятия стопа точки процесса первые N изделий, прошедших её, проходят усиленный контроль; межизделийная стадия адресует запись в поток изделия.",
  "type": "object",
  "properties": {
    "hold_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
      "description": "Снятая остановка точки процесса."
    },
    "operation_run_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
      "description": "Выполнение операции на точке процесса после снятия."
    },
    "equipment_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
      "description": "Оборудование точки процесса."
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1,
      "description": "Порядковый номер изделия после снятия (1…N)."
    },
    "of": {
      "type": "integer",
      "minimum": 1,
      "description": "Сколько изделий под усиленным контролем (N)."
    }
  },
  "required": [
    "hold_id",
    "operation_run_id",
    "ordinal",
    "of"
  ]
}
