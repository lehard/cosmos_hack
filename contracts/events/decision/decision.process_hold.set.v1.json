{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/events/decision/decision.process_hold.set.v1.json",
  "title": "DecisionProcessHoldSetV1",
  "description": "Остановка точки процесса установлена — сдерживание процесса (станок, инструмент, программа, операция) — отдельный объект от сдерживания изделий; ставит уполномоченный человек (FR-49).",
  "type": "object",
  "properties": {
    "hold_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
      "description": "Остановка."
    },
    "level": {
      "$ref": "../common/defs.v1.json#/definitions/dict_process_containment",
      "description": "Уровень."
    },
    "equipment_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
      "description": "Оборудование."
    },
    "tool_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
      "description": "Инструмент."
    },
    "program_ref": {
      "type": "string",
      "description": "Программа.",
      "maxLength": 128
    },
    "step_key": {
      "$ref": "../common/defs.v1.json#/definitions/step_key",
      "description": "Ключ шага процесса (`ant:properties/@stepKey`), к которому относится запись."
    },
    "incident_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
      "description": "Инцидент-основание."
    },
    "release_condition": {
      "type": "string",
      "maxLength": 4000,
      "description": "Условие снятия."
    },
    "reason": {
      "$ref": "../common/defs.v1.json#/definitions/reason",
      "description": "Причина: код и текст."
    }
  },
  "required": [
    "hold_id",
    "level",
    "reason"
  ]
}
