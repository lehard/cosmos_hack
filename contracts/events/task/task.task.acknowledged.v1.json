{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/events/task/task.task.acknowledged.v1.json",
  "title": "TaskTaskAcknowledgedV1",
  "description": "Задача подтверждена — исполнитель подтвердил выполнение или принятие задачи.",
  "type": "object",
  "properties": {
    "task_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
      "description": "Задача."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "done",
        "accepted",
        "declined"
      ],
      "description": "Итог."
    },
    "note": {
      "type": "string",
      "maxLength": 4000,
      "description": "Комментарий."
    }
  },
  "required": [
    "task_id",
    "outcome"
  ]
}
