{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/events/simulation/simulation.injection.applied.v1.json",
  "title": "SimulationInjectionAppliedV1",
  "description": "Инъекция цифрового стенда — кнопка поверх идущего прогона: повтор, опоздавшее событие, испорченный кадр, сбой станка, потеря данных (FR-152).",
  "type": "object",
  "properties": {
    "run_id": {
      "$ref": "../common/defs.v1.json#/definitions/run_id",
      "description": "Прогон."
    },
    "injection": {
      "type": "string",
      "enum": [
        "duplicate_event",
        "late_event",
        "corrupt_frame",
        "machine_fault",
        "data_loss",
        "tamper_outside",
        "light_change"
      ],
      "description": "Кнопка."
    },
    "target_event_id": {
      "$ref": "../common/defs.v1.json#/definitions/uuid",
      "description": "Целевое событие."
    },
    "press": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000,
      "description": "Номер нажатия кнопки в прогоне (1, 2, …): повторное нажатие — новая запись, не повтор (AD-7)."
    },
    "event_ids": {
      "type": "array",
      "items": {
        "$ref": "../common/defs.v1.json#/definitions/uuid"
      },
      "maxItems": 100,
      "description": "Записи, внесённые кнопкой через обычный приём (повтор — ни одной)."
    }
  },
  "required": [
    "run_id",
    "injection"
  ]
}
