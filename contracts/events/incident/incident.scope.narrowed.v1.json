{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/events/incident/incident.scope.narrowed.v1.json",
  "title": "IncidentScopeNarrowedV1",
  "description": "Область риска сужена — сужение — только человеком с основанием (доказательство, автор, время); каждая правка — новая версия; незаметных сужений нет (FR-61, FR-144).",
  "type": "object",
  "properties": {
    "incident_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
      "description": "Инцидент."
    },
    "item_ids": {
      "type": "array",
      "items": {
        "$ref": "../common/defs.v1.json#/definitions/item_id",
        "description": "Изделие."
      },
      "description": "Исключаемые изделия.",
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence_event_ids": {
      "type": "array",
      "items": {
        "$ref": "../common/defs.v1.json#/definitions/uuid"
      },
      "description": "Доказательства сужения.",
      "uniqueItems": true
    },
    "release_containment": {
      "type": "boolean",
      "description": "Снять блок с исключённых (как настроено, FR-62)."
    },
    "reason": {
      "$ref": "../common/defs.v1.json#/definitions/reason",
      "description": "Основание сужения."
    }
  },
  "required": [
    "incident_id",
    "item_ids",
    "evidence_event_ids",
    "reason"
  ]
}
