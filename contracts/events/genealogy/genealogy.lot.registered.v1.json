{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/events/genealogy/genealogy.lot.registered.v1.json",
  "title": "GenealogyLotRegisteredV1",
  "description": "Партия принята на входной контроль — партия физически у ОТК: количество, упаковка, сертификат есть или нет; начинается срок входного контроля.",
  "type": "object",
  "properties": {
    "lot_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
      "description": "Партия."
    },
    "actual_quantity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000,
      "description": "Фактическое количество."
    },
    "packaging_ok": {
      "type": "boolean",
      "description": "Упаковка без повреждений."
    },
    "certificate_present": {
      "type": "boolean",
      "description": "Сертификат поставщика есть."
    },
    "registered_by": {
      "$ref": "../common/defs.v1.json#/definitions/person_ref",
      "description": "Контролёр ВК."
    },
    "lot_kind": {
      "type": "string",
      "enum": [
        "lot",
        "heat"
      ],
      "description": "Вид: партия материала или покупных / плавка (FR-45). Садка — временная группа genealogy.group.formed (kind = charge)."
    },
    "heat_no": {
      "type": "string",
      "maxLength": 64,
      "description": "Номер плавки партии (запрос «плавка → все изделия», FR-45)."
    },
    "item_type_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
      "description": "Номенклатура партии."
    }
  },
  "required": [
    "lot_id",
    "actual_quantity",
    "certificate_present",
    "registered_by"
  ]
}
