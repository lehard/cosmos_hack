{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/events/security/security.key.alert.v1.json",
  "title": "SecurityKeyAlertV1",
  "description": "Тревога по ключу — повторный ключ человека, чужой ключ (пользователь сеанса ≠ субъект ключа), расхождение локального журнала агента с сервером (AD-11, AD-14).",
  "type": "object",
  "properties": {
    "key_ref": {
      "$ref": "../common/defs.v1.json#/definitions/key_ref",
      "description": "Ключ."
    },
    "person_id": {
      "$ref": "../common/defs.v1.json#/definitions/person_ref",
      "description": "Субъект."
    },
    "alert": {
      "type": "string",
      "enum": [
        "duplicate_key",
        "foreign_key",
        "agent_journal_mismatch",
        "level1_rate_exceeded"
      ],
      "description": "Вид тревоги."
    },
    "detail": {
      "type": "string",
      "maxLength": 4000,
      "description": "Подробности."
    }
  },
  "required": [
    "alert"
  ]
}
