{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/events/journal/journal.checkpoint.recorded.v1.json",
  "title": "JournalCheckpointRecordedV1",
  "description": "Контрольная точка хранителя — хранитель принял головы цепочек: `seq`, звено, диапазон `committed_at`, отпечаток предыдущей точки; пакет DSSE `hybrid` у хранителя (AD-8).",
  "type": "object",
  "properties": {
    "checkpoint_digest": {
      "$ref": "../common/defs.v1.json#/definitions/digest",
      "description": "Отпечаток контрольной точки."
    },
    "main_seq": {
      "$ref": "../common/defs.v1.json#/definitions/seq",
      "description": "Голова основной цепочки."
    },
    "main_link": {
      "$ref": "../common/defs.v1.json#/definitions/digest",
      "description": "Звено."
    },
    "ca_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Голова цепочки CA."
    },
    "ca_link": {
      "$ref": "../common/defs.v1.json#/definitions/digest",
      "description": "Звено CA."
    },
    "keeper_time": {
      "$ref": "../common/defs.v1.json#/definitions/timestamp",
      "description": "Время по часам хранителя."
    }
  },
  "required": [
    "checkpoint_digest",
    "main_seq",
    "main_link",
    "keeper_time"
  ]
}
