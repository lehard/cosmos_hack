{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/integrations/mes/b2mml/common.schema.json",
  "title": "B2mmlCommon",
  "description": "Общие определения подмножества B2MML V7 (ISA-95 / IEC 62264, MESA International) в форме B2MML-JSON для контракта mes.isa95.v1 (FR-93, AD-18; проектное предположение): имена элементов и атрибутов — как в XSD B2MML, атрибуты XML — свойствами (releaseID, versionID, actionCode).",
  "definitions": {
    "Identifier": {
      "type": "string",
      "description": "Идентификатор B2MML (IdentifierType) строкой.",
      "maxLength": 128
    },
    "DateTime": {
      "type": "string",
      "description": "Время RFC 3339 UTC с миллисекундами (DateTimeType).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "ReleaseID": {
      "type": "string",
      "description": "Релиз B2MML (атрибут releaseID).",
      "pattern": "^7\\.[0-9]{2}$"
    },
    "VersionID": {
      "type": "string",
      "description": "Версия контракта ant поверх B2MML (атрибут versionID).",
      "pattern": "^mes\\.isa95\\.v[0-9]+$"
    },
    "Sender": {
      "type": "object",
      "description": "Отправитель BOD (ApplicationArea/Sender).",
      "additionalProperties": false,
      "properties": {
        "LogicalID": {
          "type": "string",
          "description": "Логический ID системы-отправителя.",
          "maxLength": 64
        },
        "ComponentID": {
          "type": "string",
          "description": "Компонент отправителя.",
          "maxLength": 64
        },
        "ConfirmationCode": {
          "type": "string",
          "enum": [
            "Always",
            "Never",
            "OnError"
          ],
          "description": "Когда нужен ConfirmBOD: всегда, никогда, при ошибке."
        }
      },
      "required": [
        "LogicalID"
      ]
    },
    "Receiver": {
      "type": "object",
      "description": "Получатель BOD.",
      "additionalProperties": false,
      "properties": {
        "LogicalID": {
          "type": "string",
          "description": "Логический ID получателя.",
          "maxLength": 64
        }
      },
      "required": [
        "LogicalID"
      ]
    },
    "ApplicationArea": {
      "type": "object",
      "description": "Заголовок сообщения: отправитель, время, BODID — ключ идемпотентности.",
      "additionalProperties": false,
      "properties": {
        "Sender": {
          "$ref": "#/definitions/Sender",
          "description": "Отправитель."
        },
        "Receiver": {
          "$ref": "#/definitions/Receiver",
          "description": "Получатель."
        },
        "CreationDateTime": {
          "$ref": "#/definitions/DateTime",
          "description": "Время формирования."
        },
        "BODID": {
          "type": "string",
          "description": "Идентификатор сообщения (Business Object Document ID).",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        }
      },
      "required": [
        "Sender",
        "CreationDateTime",
        "BODID"
      ]
    },
    "Quantity": {
      "type": "object",
      "description": "Количество (QuantityType).",
      "additionalProperties": false,
      "properties": {
        "QuantityString": {
          "type": "string",
          "description": "Значение строкой (целое).",
          "pattern": "^[0-9]{1,9}$"
        },
        "UnitOfMeasure": {
          "type": "string",
          "description": "Единица.",
          "maxLength": 16
        }
      },
      "required": [
        "QuantityString"
      ]
    },
    "EmptyVerb": {
      "type": "object",
      "description": "Глагол без параметров (Process, Notify, Confirm).",
      "additionalProperties": false,
      "properties": {}
    }
  }
}
