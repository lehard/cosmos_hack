{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/normative/templates.schema.json",
  "title": "DocumentTemplatesSeed",
  "description": "Перечень шаблонов документов шагов процесса (AD-12): normative/documents/templates.v*.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "templates"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999,
      "description": "Версия."
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "description": "Шаблоны.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "class"
        ],
        "description": "Шаблон.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Идентификатор шаблона."
          },
          "title": {
            "type": "string",
            "maxLength": 256,
            "description": "Название документа."
          },
          "class": {
            "type": "string",
            "enum": [
              "record",
              "decision",
              "requirement",
              "input"
            ],
            "description": "Класс: запись, решение, требование, вход."
          }
        }
      }
    }
  }
}
