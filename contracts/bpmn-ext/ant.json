{
  "name": "ant",
  "uri": "urn:ant:bpmn-ext:1",
  "prefix": "ant",
  "xml": {
    "tagAlias": "lowerCase"
  },
  "description": "Расширение BPMN 2.0 системы ant (AD-17, FR-12, FR-156): свойства элементов процесса в extensionElements пространства urn:ant:bpmn-ext:1. Источник схемы: из дескриптора генерируются Go-структуры XML, XSD и таблица документации (эпик 02). Значения перечислений и обязательность — contracts/bpmn-ext/rules.yaml.",
  "associations": [],
  "types": [
    {
      "name": "Properties",
      "superClass": [
        "Element"
      ],
      "description": "Свойства шага: стабильный ключ, вид, цех и склад, специальный процесс, буфер, закрытие доступа к зоне, заверитель бумажной подписи, закрывающая точка, точка контроля, лимит доработок, учётное действие, тип события-триггера, область таймера.",
      "properties": [
        {
          "name": "stepKey",
          "type": "String",
          "isAttr": true,
          "description": "Стабильный ключ шага, сохраняемый между версиями; смена смысла — новый ключ (AD-17)."
        },
        {
          "name": "stepKind",
          "type": "String",
          "isAttr": true,
          "description": "Вид шага: operation | automated_inspection | human_inspection | movement | storage."
        },
        {
          "name": "workshop",
          "type": "String",
          "isAttr": true,
          "description": "Цех (для дорожки) — id места вида workshop."
        },
        {
          "name": "warehouse",
          "type": "String",
          "isAttr": true,
          "description": "Склад цеха (для дорожки)."
        },
        {
          "name": "specialProcess",
          "type": "Boolean",
          "isAttr": true,
          "description": "Специальный процесс (FR-151, ГОСТ Р 58633 п. 3.17)."
        },
        {
          "name": "bufferPlace",
          "type": "Boolean",
          "isAttr": true,
          "description": "Буфер или место очереди (FR-12)."
        },
        {
          "name": "closesZoneAccess",
          "type": "String",
          "isAttr": true,
          "description": "Зоны, доступ к которым закрывает шаг, через пробел (FR-20)."
        },
        {
          "name": "paperAttester",
          "type": "String",
          "isAttr": true,
          "description": "Роль заверителя бумажной подписи на шаге (AD-43); у заверителя — полномочие paper_attestation в области."
        },
        {
          "name": "closingPoint",
          "type": "String",
          "isAttr": true,
          "description": "Закрывающая точка: ZT-1…ZT-6, ZT-4.1, ZT-4.2, ZT-R, ZT-V."
        },
        {
          "name": "inspectionPoint",
          "type": "String",
          "isAttr": true,
          "description": "Точка контроля: KT-1…KT-5, KT-4d."
        },
        {
          "name": "operationCode",
          "type": "String",
          "isAttr": true,
          "description": "Операция по маршрутной карте."
        },
        {
          "name": "reworkLimit",
          "type": "Integer",
          "isAttr": true,
          "description": "Лимит повторов или доработок (FR-18)."
        },
        {
          "name": "reworkLimitScope",
          "type": "String",
          "isAttr": true,
          "description": "К чему лимит: item | zone | loop."
        },
        {
          "name": "erpAction",
          "type": "String",
          "isAttr": true,
          "description": "Учётное действие на событии-сообщении «в 1С» (AD-18)."
        },
        {
          "name": "triggerEventType",
          "type": "String",
          "isAttr": true,
          "description": "Тип события каталога, которое запускает стартовое или промежуточное событие-сообщение (решение Д-5)."
        },
        {
          "name": "timerScope",
          "type": "String",
          "isAttr": true,
          "description": "Для граничного таймера: until_started — окно до начала операции; activity — всё время шага."
        },
        {
          "name": "outcome",
          "type": "String",
          "isAttr": true,
          "description": "Для конечного события вызываемого подпроцесса: значение переменной nc.outcome в точке вызова."
        }
      ]
    },
