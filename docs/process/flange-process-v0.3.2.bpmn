      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="KE_di" bpmnElement="KE">
        <dc:Bounds x="2512" y="902" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ann_Block_di" bpmnElement="Ann_Block">
        <dc:Bounds x="530" y="66" width="380" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ann_Decision_di" bpmnElement="Ann_Decision">
        <dc:Bounds x="930" y="66" width="380" height="100" />
      </bpmndi:BPMNShape>
