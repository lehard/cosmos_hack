{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sergey-palych:integration:1c:control-result:1.0",
  "title": "Результат контроля → 1С (тело POST /erp/hs/qc/v1/quality-acts), контракт qc-1c.control-result 1.0 [П, ждёт подтверждения соседей]",
  "description": "Исходящее сообщение: мы — отправитель, поэтому схема строгая (additionalProperties: false). Все ID 1С условные; в настоящей 1С вместо них GUID Ref_Key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "message_id", "sent_at", "result_id", "gate", "subject", "nomenclature_ref_key", "operation", "outcome", "signed", "basis"],
  "properties": {
    "contract": {"const": "qc-1c.control-result"},
    "contract_version": {"type": "string", "pattern": "^1\\.[0-9]+$", "description": "Версия контракта обмена с 1С. Не версия приложения и не версия анализатора"},
    "message_id": {"type": "string", "pattern": "^qc-out-[0-9]{6}$", "description": "Совпадает с заголовком X-Message-Id. Выводится из бизнес-ключа «решение + вид сообщения», при повторе не меняется"},
    "sent_at": {"type": "string", "format": "date-time"},
    "result_id": {"type": "string", "minLength": 1, "description": "Наш ID результата контроля. В 1С — реквизит «ВнешнийИдентификатор» [П]"},
    "supersedes_result_id": {"type": ["string", "null"], "description": "Если этот результат заменяет прежний по тому же изделию и ЗТ (новое решение после пересмотра). Прежний акт в 1С не правится — создаётся новый со ссылкой"},
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "presentation_no"],
      "properties": {
        "code": {"enum": ["ZT-1", "ZT-2", "ZT-3", "ZT-4", "ZT-5", "ZT-6", "ZT-R"], "description": "Закрывающая точка. ZT-R — решение по несоответствию"},
        "name": {"type": "string"},
        "presentation_no": {"type": "integer", "minimum": 1, "description": "Номер предъявления: 1 — первое, 2 — повторное после переделки"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "qty", "unit_okei"],
      "properties": {
        "kind": {"enum": ["item", "items", "lot"], "description": "item — одно изделие; items — список изделий одного решения; lot — партия покупных"},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["internal_id", "series_ref_key"],
            "properties": {
              "internal_id": {"type": "string", "description": "Наш ID изделия (F-001)"},
              "display": {"type": "string", "description": "Как на экране и в бумаге (Ф-001)"},
              "series_ref_key": {"type": "string", "minLength": 1, "description": "Серия номенклатуры в 1С"}
            }
          }
        },
        "lot": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["internal_id", "receipt_ref_key"],
          "properties": {
            "internal_id": {"type": "string"},
            "display": {"type": "string"},
            "receipt_ref_key": {"type": "string", "minLength": 1, "description": "Поступление товаров (серия партии) в 1С"},
            "component_ids": {"type": "array", "items": {"type": "string"}}
          }
        },
        "qty": {"type": "integer", "minimum": 1},
        "unit_okei": {"const": "796", "description": "Код ОКЕИ «штука». Других единиц в контракте 1.0 нет"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"enum": ["item", "items"]}}}, "then": {"required": ["items"], "properties": {"items": {"minItems": 1}}}},
        {"if": {"properties": {"kind": {"const": "lot"}}}, "then": {"required": ["lot"], "properties": {"lot": {"type": "object"}}}}
      ]
    },
    "nomenclature_ref_key": {"type": "string", "minLength": 1},
    "order_ref_key": {"type": ["string", "null"], "description": "Заказ на производство; для ЗТ-1 по партии — null"},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name"],
      "properties": {
        "code": {"type": "string"},
        "name": {"type": "string"}
      }
    },
    "line_id": {"type": ["string", "null"], "enum": ["L-FL-1", "L-FL-2", null]},
    "warehouse_ref_key": {"type": ["string", "null"], "description": "Где изделие физически сейчас (склад или цех в 1С)"},
    "outcome": {"enum": ["accepted", "accepted_by_permit", "nonconforming"], "description": "Годно / годно по разрешению на отклонение / не годно. «Оценка невозможна» сюда не входит: по ней ЗТ не подписывают и в 1С ничего не уходит"},
    "data_completeness": {"enum": ["full", "incomplete"], "description": "[П] Для ЗТ-3 «годно при неполных данных». По умолчанию full"},
    "permit": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["number"],
      "properties": {
        "number": {"type": "string", "description": "Номер разрешения на отклонение"},
        "kd_clause": {"type": "string"},
        "valid_until": {"type": "string", "format": "date"}
      }
    },
    "nonconformities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nc_id", "title", "severity"],
        "properties": {
          "nc_id": {"type": "string"},
          "display": {"type": "string"},
          "title": {"type": "string", "description": "Что не так — подтверждённое несоответствие, а не гипотеза о причине"},
          "defect_class": {"type": "string", "description": "burn_through, porosity, undercut, base_metal_pore, missing_torque_mark, scratch, process_deviation; неизвестный класс 1С принимает как текст"},
          "zone": {"type": "string"},
          "severity": {"enum": ["critical", "major", "minor"]},
          "item_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "disposition": {"enum": [null, "rework", "component_replacement", "repair", "use_as_is", "scrap", "disassemble", "return_to_supplier"], "description": "Решение по изделию. Только для ZT-R; при «не годно» на ЗТ-2…ЗТ-6 — null (решение примут отдельно)"},
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "signers", "signature_class"],
      "properties": {
        "at": {"type": "string", "format": "date-time"},
        "signers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "role"],
            "properties": {
              "ref": {"type": "string", "description": "Псевдоним сотрудника (QC-02). ФИО в сообщении нет"},
              "role": {"enum": ["QC_INSPECTOR", "QC_HEAD", "TECHNOLOGIST", "CHIEF_WELDER", "CUSTOMER_REP", "MILITARY_REP", "DESIGNER", "TESTER"]}
            }
          }
        },
        "signature_class": {"enum": ["token", "paper"]}
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id"],
      "properties": {
        "decision_id": {"type": "string", "description": "Наш ID подписанного решения. По нему 1С связывает результат контроля и учётное движение"},
        "nc_ids": {"type": "array", "items": {"type": "string"}},
        "evidence_url": {"type": "string", "format": "uri", "description": "Ссылка в нашу систему. Кадры и журналы в 1С не передаются"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "accepted_by_permit"}}}, "then": {"required": ["permit"], "properties": {"permit": {"type": "object"}}}},
    {"if": {"properties": {"outcome": {"const": "nonconforming"}}}, "then": {"required": ["nonconformities"], "properties": {"nonconformities": {"minItems": 1}}}},
    {"if": {"properties": {"gate": {"properties": {"code": {"const": "ZT-R"}}}}}, "then": {"required": ["disposition"], "properties": {"outcome": {"const": "nonconforming"}, "disposition": {"type": "string"}}}}
  ]
}
