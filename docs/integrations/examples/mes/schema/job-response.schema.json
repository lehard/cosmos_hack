{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sergey-palych:integration:mes:JobResponse:1.0",
  "title": "MES → мы: ход выполнения наряда (Sync JobResponse), qc-mes 1.0 [П]",
  "description": "Входящее от MES: схема терпимая к новым полям (additionalProperties: true), но обязательные поля и значения перечислений проверяются.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ApplicationArea",
    "DataArea"
  ],
  "properties": {
    "ApplicationArea": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "Sender",
        "Receiver",
        "CreationDateTime",
        "BODID",
        "ContractVersion"
      ],
      "properties": {
        "Sender": {
          "type": "object",
          "required": [
            "LogicalID"
          ],
          "properties": {
            "LogicalID": {
              "enum": [
                "SERGEY-PALYCH-QC",
                "MES"
              ]
            }
          }
        },
        "Receiver": {
          "type": "object",
          "required": [
            "LogicalID"
          ],
          "properties": {
            "LogicalID": {
              "enum": [
                "SERGEY-PALYCH-QC",
                "MES"
              ]
            }
          }
        },
        "CreationDateTime": {
          "type": "string",
          "format": "date-time"
        },
        "BODID": {
          "type": "string",
          "pattern": "^mes-(in|out)-[0-9]{6}$",
          "description": "Номер сообщения; при повторе не меняется"
        },
        "ContractVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$",
          "description": "Версия контракта qc-mes. Не версия MES и не версия приложения"
        }
      }
    },
    "DataArea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Verb",
        "JobResponse"
      ],
      "properties": {
        "Verb": {
          "enum": [
            "Sync",
            "Process"
          ],
          "description": "В B2MML глагол — отдельный элемент (Process, Sync, Acknowledge …); здесь упрощено до строки [П, уточнить по схеме B2MML]"
        },
        "JobResponse": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "ID",
              "JobOrderID",
              "JobState"
            ],
            "properties": {
              "ID": {
                "type": "string"
              },
              "JobOrderID": {
                "type": "string"
              },
              "JobState": {
                "enum": [
                  "Waiting",
                  "Ready",
                  "Running",
                  "Completed",
                  "Aborted",
                  "Held",
                  "Suspended",
                  "Closed"
                ],
                "description": "Неизвестное значение — карантин E_UNKNOWN_ENUM"
              },
              "StartTime": {
                "type": "string",
                "format": "date-time"
              },
              "EndTime": {
                "type": "string",
                "format": "date-time"
              },
              "EquipmentActual": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "EquipmentID"
                  ],
                  "properties": {
                    "EquipmentID": {
                      "type": "string"
                    }
                  }
                }
              },
              "PersonnelActual": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "PersonID"
                  ],
                  "properties": {
                    "PersonID": {
                      "type": "string"
                    }
                  }
                }
              },
              "MaterialActual": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "MaterialSubLotID"
                  ],
                  "properties": {
                    "MaterialSubLotID": {
                      "type": "string"
                    },
                    "MaterialUse": {
                      "enum": [
                        "Produced",
                        "Consumed"
                      ]
                    }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "JobState": {
                      "enum": [
                        "Completed",
                        "Aborted"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "StartTime",
                    "EndTime"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "JobState": {
                      "const": "Running"
                    }
                  }
                },
                "then": {
                  "required": [
                    "StartTime"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  }
}
