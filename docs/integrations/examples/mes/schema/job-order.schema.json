{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sergey-palych:integration:mes:JobOrder:1.0",
  "title": "MES → мы: наряд (Process JobOrder), qc-mes 1.0 [П]",
  "description": "Входящее от MES: схема терпимая к новым полям (additionalProperties: true), но обязательные поля и значения перечислений проверяются.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ApplicationArea",
    "DataArea"
  ],
  "properties": {
    "ApplicationArea": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "Sender",
        "Receiver",
        "CreationDateTime",
        "BODID",
        "ContractVersion"
      ],
      "properties": {
        "Sender": {
          "type": "object",
          "required": [
            "LogicalID"
          ],
          "properties": {
            "LogicalID": {
              "enum": [
                "SERGEY-PALYCH-QC",
                "MES"
              ]
            }
          }
        },
        "Receiver": {
          "type": "object",
          "required": [
            "LogicalID"
          ],
          "properties": {
            "LogicalID": {
              "enum": [
                "SERGEY-PALYCH-QC",
                "MES"
              ]
            }
          }
        },
        "CreationDateTime": {
          "type": "string",
          "format": "date-time"
        },
        "BODID": {
          "type": "string",
          "pattern": "^mes-(in|out)-[0-9]{6}$",
          "description": "Номер сообщения; при повторе не меняется"
        },
        "ContractVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$",
          "description": "Версия контракта qc-mes. Не версия MES и не версия приложения"
        }
      }
    },
    "DataArea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Verb",
        "JobOrder"
      ],
      "properties": {
        "Verb": {
          "enum": [
            "Process",
            "Sync"
          ],
          "description": "В B2MML глагол — отдельный элемент (Process, Sync, Acknowledge …); здесь упрощено до строки [П, уточнить по схеме B2MML]"
        },
        "JobOrder": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "ID",
              "WorkType",
              "WorkMasterID",
              "StartTime",
              "HierarchyScope",
              "MaterialRequirement"
            ],
            "properties": {
              "ID": {
                "type": "string",
                "description": "Номер наряда MES"
              },
              "Description": {
                "type": "string"
              },
              "WorkType": {
                "enum": [
                  "Production",
                  "Rework",
                  "Inspection"
                ]
              },
              "WorkMasterID": {
                "type": "string",
                "description": "Операция техпроцесса"
              },
              "PreviousJobOrderID": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Для повторного выполнения — наряд прежнего выполнения [П: расширение]"
              },
              "StartTime": {
                "type": "string",
                "format": "date-time"
              },
              "EndTime": {
                "type": "string",
                "format": "date-time"
              },
              "Priority": {
                "type": "integer"
              },
              "HierarchyScope": {
                "type": "object",
                "required": [
                  "EquipmentID",
                  "EquipmentLevel"
                ],
                "properties": {
                  "EquipmentID": {
                    "type": "string"
                  },
                  "EquipmentLevel": {
                    "enum": [
                      "Enterprise",
                      "Site",
                      "Area",
                      "WorkCenter",
                      "WorkUnit"
                    ]
                  }
                }
              },
              "EquipmentRequirement": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "EquipmentID"
                  ],
                  "properties": {
                    "EquipmentID": {
                      "type": "string"
                    }
                  }
                }
              },
              "PersonnelRequirement": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "PersonID"
                  ],
                  "properties": {
                    "PersonID": {
                      "type": "string"
                    }
                  }
                }
              },
              "MaterialRequirement": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "MaterialDefinitionID",
                    "MaterialSubLotID",
                    "MaterialUse",
                    "Quantity"
                  ],
                  "properties": {
                    "MaterialDefinitionID": {
                      "type": "string"
                    },
                    "MaterialSubLotID": {
                      "type": "string"
                    },
                    "MaterialUse": {
                      "enum": [
                        "Produced",
                        "Consumed"
                      ]
                    },
                    "Quantity": {
                      "type": "object",
                      "required": [
                        "QuantityString",
                        "UnitOfMeasure"
                      ],
                      "properties": {
                        "QuantityString": {
                          "type": "string"
                        },
                        "UnitOfMeasure": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "Parameter": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ID",
                    "Value"
                  ],
                  "properties": {
                    "ID": {
                      "type": "string"
                    },
                    "Value": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "UnitOfMeasure": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
