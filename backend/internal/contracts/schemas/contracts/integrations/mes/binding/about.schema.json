{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/integrations/mes/binding/about.schema.json",
  "title": "MesBindingAbout",
  "description": "Описание канала MES (`GET ‹канал›/about`, HTTP-привязка mes.isa95.v1, проектное предположение): релиз B2MML и версии контракта ant, которые принимает MES или её шина. Адаптер сверяет его при старте; нашей версии нет — канал degraded, блоки не отправляются (AD-18).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "logical_id": {
      "type": "string",
      "description": "Логический ID MES (Sender/LogicalID).",
      "maxLength": 64
    },
    "release_id": {
      "type": "string",
      "description": "Релиз B2MML.",
      "pattern": "^7\\.[0-9]{2}$"
    },
    "supported": {
      "type": "array",
      "description": "Версии контракта ant поверх B2MML.",
      "items": {
        "type": "string",
        "description": "Версия (mes.isa95.v1).",
        "pattern": "^mes\\.isa95\\.v[0-9]+$"
      },
      "minItems": 1,
      "maxItems": 20
    },
    "product": {
      "type": "string",
      "description": "Система (1С:MES, Галактика MES, ГОЛЬФСТРИМ, собственная, stand).",
      "maxLength": 128
    }
  },
  "required": [
    "logical_id",
    "release_id",
    "supported"
  ]
}
