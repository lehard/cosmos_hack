{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/events/simulation/simulation.run.started.v1.json",
  "title": "SimulationRunStartedV1",
  "description": "Прогон сценария запущен — `run_id`, seed, версия сценария, скорость; всё, что прогон меняет, — записями с `run_id` (AD-38).",
  "type": "object",
  "properties": {
    "run_id": {
      "$ref": "../common/defs.v1.json#/definitions/run_id",
      "description": "Прогон."
    },
    "scenario_id": {
      "type": "string",
      "description": "Сценарий.",
      "maxLength": 128
    },
    "scenario_version": {
      "type": "string",
      "description": "Версия сценария.",
      "maxLength": 64
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Seed генератора."
    },
    "speed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "description": "Скорость ×1…×1000."
    },
    "mode": {
      "type": "string",
      "enum": [
        "interactive",
        "autocheck",
        "load"
      ],
      "description": "Режим."
    }
  },
  "required": [
    "run_id",
    "scenario_id",
    "scenario_version",
    "seed",
    "speed",
    "mode"
  ]
}
