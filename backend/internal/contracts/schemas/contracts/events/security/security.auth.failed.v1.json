{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/events/security/security.auth.failed.v1.json",
  "title": "SecurityAuthFailedV1",
  "description": "Неудачный вход — ошибка аутентификации (логин и пароль) — событие шины безопасности (AD-15, AD-24).",
  "type": "object",
  "properties": {
    "login": {
      "type": "string",
      "description": "Логин попытки.",
      "maxLength": 64
    },
    "client_ip": {
      "type": "string",
      "description": "Адрес клиента.",
      "maxLength": 64
    },
    "reason": {
      "type": "string",
      "enum": [
        "bad_credentials",
        "account_locked",
        "account_pending",
        "rate_limited"
      ],
      "description": "Причина."
    }
  },
  "required": [
    "reason"
  ]
}
