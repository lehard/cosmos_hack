{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/events/policy/policy.role.unassigned.v1.json",
  "title": "PolicyRoleUnassignedV1",
  "description": "Роль снята — роль в области больше не действует (FR-78).",
  "type": "object",
  "properties": {
    "person_id": {
      "$ref": "../common/defs.v1.json#/definitions/person_ref",
      "description": "Сотрудник."
    },
    "role_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
      "description": "Роль."
    },
    "scope": {
      "type": "string",
      "description": "Область действия: путь `здание/цех/участок/рабочее место` (иерархия областей, AD-15).",
      "pattern": "^[a-z0-9_-]+(/[a-z0-9_-]+)*$",
      "maxLength": 256
    },
    "effective_from": {
      "$ref": "../common/defs.v1.json#/definitions/timestamp",
      "description": "С какого момента."
    },
    "reason": {
      "$ref": "../common/defs.v1.json#/definitions/reason",
      "description": "Причина: код и текст."
    }
  },
  "required": [
    "person_id",
    "role_id",
    "scope",
    "effective_from"
  ]
}
