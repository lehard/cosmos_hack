{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/events/incident/incident.incident.closed.v1.json",
  "title": "IncidentIncidentClosedV1",
  "description": "Инцидент закрыт — итог: сколько было в области, сколько подтверждено, сколько исключено; показатель сокращения области (FR-9).",
  "type": "object",
  "properties": {
    "incident_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
      "description": "Инцидент."
    },
    "initial_size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Размер области при создании."
    },
    "confirmed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Подтверждено."
    },
    "excluded": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Исключено."
    },
    "summary": {
      "type": "string",
      "maxLength": 4000,
      "description": "Итог."
    },
    "scope": {
      "type": "string",
      "enum": [
        "risk_scope",
        "investigation"
      ],
      "description": "Что закрыто: область риска (risk_scope, по умолчанию) или расследование целиком (investigation — обе причины отвечены, эффективность мер проверена)."
    }
  },
  "required": [
    "incident_id",
    "initial_size",
    "confirmed",
    "excluded"
  ]
}
