{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/events/reference/reference.shift.scheduled.v1.json",
  "title": "ReferenceShiftScheduledV1",
  "description": "График смен — смены по участкам: начало, конец; смена-шаблон повторяется каждый (рабочий) день до repeat_until (FR-81).",
  "type": "object",
  "properties": {
    "shift_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
      "description": "Смена."
    },
    "location_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
      "description": "Участок или цех."
    },
    "starts_at": {
      "$ref": "../common/defs.v1.json#/definitions/timestamp",
      "description": "Начало."
    },
    "ends_at": {
      "$ref": "../common/defs.v1.json#/definitions/timestamp",
      "description": "Конец."
    },
    "name": {
      "type": "string",
      "description": "Название смены.",
      "maxLength": 64
    },
    "repeat_until": {
      "$ref": "../common/defs.v1.json#/definitions/timestamp",
      "description": "Повторять смену каждый день в то же местное время, пока начало не позже этого момента; отсутствует — одна смена."
    },
    "working_days_only": {
      "type": "boolean",
      "description": "Повторять только в рабочие дни производственного календаря."
    }
  },
  "required": [
    "shift_id",
    "location_id",
    "starts_at",
    "ends_at"
  ]
}
