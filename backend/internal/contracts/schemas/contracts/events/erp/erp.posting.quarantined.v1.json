{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/events/erp/erp.posting.quarantined.v1.json",
  "title": "ErpPostingQuarantinedV1",
  "description": "Исходящее сообщение в карантине — повтор при транспортных ошибках исчерпан или ошибка данных без автоповтора — задача администратору (FR-96).",
  "type": "object",
  "properties": {
    "business_key": {
      "type": "string",
      "description": "Бизнес-ключ.",
      "maxLength": 256
    },
    "request_event_id": {
      "$ref": "../common/defs.v1.json#/definitions/uuid",
      "description": "Запрос."
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "description": "Попыток."
    },
    "last_error_code": {
      "type": "string",
      "description": "Код последней ошибки.",
      "maxLength": 96
    },
    "cause": {
      "type": "string",
      "enum": [
        "transport_exhausted",
        "data_error",
        "contract_incompatible",
        "correction_pending"
      ],
      "description": "Почему в карантине: повторы при транспортных ошибках исчерпаны / ошибка данных без автоповтора / несовместимый контракт / новая версия отправленного ждёт решения человека (AD-7)."
    },
    "error_message": {
      "type": "string",
      "maxLength": 4000,
      "description": "Текст последней ошибки."
    },
    "message_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "description": "Версия содержимого, которая в карантине."
    },
    "item_id": {
      "$ref": "../common/defs.v1.json#/definitions/item_id",
      "description": "Изделие."
    },
    "lot_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
      "description": "Партия."
    }
  },
  "required": [
    "business_key",
    "request_event_id",
    "attempts"
  ]
}
