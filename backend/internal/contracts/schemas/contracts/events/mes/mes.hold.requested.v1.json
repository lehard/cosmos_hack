{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/events/mes/mes.hold.requested.v1.json",
  "title": "MesHoldRequestedV1",
  "description": "Блокировка передаётся в MES — заблокированное изделие или партия не должны получить следующую операцию — блок уходит в MES (FR-93).",
  "type": "object",
  "properties": {
    "business_key": {
      "type": "string",
      "description": "Бизнес-ключ.",
      "maxLength": 256
    },
    "item_id": {
      "$ref": "../common/defs.v1.json#/definitions/item_id",
      "description": "Изделие."
    },
    "lot_id": {
      "$ref": "../common/defs.v1.json#/definitions/object_id",
      "description": "Партия."
    },
    "hold": {
      "type": "boolean",
      "description": "true — заблокировать, false — снять."
    }
  },
  "required": [
    "business_key",
    "hold"
  ]
}
