{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/events/mes/mes.hold.responded.v1.json",
  "title": "MesHoldRespondedV1",
  "description": "Ответ MES на блокировку — квитанция MES.",
  "type": "object",
  "properties": {
    "business_key": {
      "type": "string",
      "description": "Бизнес-ключ.",
      "maxLength": 256
    },
    "request_event_id": {
      "$ref": "../common/defs.v1.json#/definitions/uuid",
      "description": "Запрос."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "accepted",
        "duplicate",
        "rejected"
      ],
      "description": "Итог."
    },
    "error_code": {
      "type": "string",
      "description": "Код ошибки.",
      "maxLength": 96
    }
  },
  "required": [
    "business_key",
    "request_event_id",
    "outcome"
  ]
}
