{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/internal/verifier/report.v1.json",
  "title": "VerifierReportV1",
  "description": "Подписанный отчёт независимого верификатора (AD-9, AD-46): класс `verifier-report`, профиль hybrid, ключ из тома verifier. Сдаётся хранителю; ant журналирует только ссылку (`security.integrity.checked`). Закрытая схема.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999,
      "description": "Версия формата."
    },
    "crypto_profile": {
      "type": "string",
      "enum": [
        "hybrid"
      ],
      "description": "Профиль."
    },
    "signers": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Ключ верификатора.",
        "pattern": "^[a-z0-9][a-z0-9._:-]{0,95}@[1-9][0-9]{0,5}$"
      },
      "description": "Подписанты.",
      "minItems": 2,
      "maxItems": 2
    },
    "verifier_build": {
      "type": "string",
      "description": "Хеш бинарника верификатора.",
      "pattern": "^streebog256:[0-9a-f]{64}$"
    },
    "domain_builds_allowed": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Хеш допустимой сборки доменного пакета.",
        "pattern": "^streebog256:[0-9a-f]{64}$"
      },
      "description": "Перечень допустимых сборок из нормативного слоя."
    },
    "generated_at": {
      "type": "string",
      "description": "Когда сформирован (часы верификатора).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "trust_anchors_digest": {
      "type": "string",
      "description": "Отпечаток файла trust-anchors.",
      "pattern": "^streebog256:[0-9a-f]{64}$"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "description": "Проверенный диапазон.",
      "properties": {
        "main_from_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "С."
        },
        "main_to_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "По."
        },
        "ca_to_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Цепочка CA по."
        },
        "last_checkpoint_no": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Последняя контрольная точка."
        }
      },
      "required": [
        "main_from_seq",
        "main_to_seq",
        "ca_to_seq",
        "last_checkpoint_no"
      ]
    },
    "run_id": {
      "type": "string",
      "description": "Прогон сценария, если проверялся он.",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "virtual_time": {
      "type": "boolean",
      "description": "Временные проверки — по виртуальному времени сценария."
    },
    "verdict": {
      "type": "string",
      "enum": [
        "intact",
        "intact_with_reservations",
        "violated"
      ],
      "description": "Общий вердикт: «цело» только при нуле «не проверяемо»."
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "description": "Итог одной проверки.",
        "properties": {
          "check": {
            "type": "string",
            "enum": [
              "chains",
              "checkpoints",
              "signatures",
              "signing_moment",
              "authority",
              "bpmn_quorum",
              "reactions",
              "coverage",
              "source_seq",
              "rendering",
              "late_write",
              "build",
              "projections",
              "genesis"
            ],
            "description": "Проверка."
          },
          "status": {
            "type": "string",
            "enum": [
              "intact",
              "rejected",
              "not_verifiable"
            ],
            "description": "Статус."
          },
          "checked": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Сколько объектов проверено."
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "description": "Нарушение или оговорка.",
              "properties": {
                "seq": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Запись."
                },
                "chain": {
                  "type": "string",
                  "enum": [
                    "main",
                    "ca"
                  ],
                  "description": "Цепочка."
                },
                "ca_ref": {
                  "type": "string",
                  "description": "Номер критического действия CA-‹n›.",
                  "pattern": "^CA-[1-9][0-9]*$"
                },
                "code": {
                  "type": "string",
                  "description": "Код.",
                  "pattern": "^[a-z][a-z0-9_.]*$"
                },
                "detail": {
                  "type": "string",
                  "description": "Что и где — по-русски.",
                  "maxLength": 2000
                }
              },
              "required": [
                "code",
                "detail"
              ]
            },
            "description": "Находки."
          }
        },
        "required": [
          "check",
          "status",
          "checked",
          "findings"
        ]
      },
      "description": "Проверки.",
      "minItems": 1
    },
    "signature_classes": {
      "type": "object",
      "additionalProperties": false,
      "description": "Подписи по классам происхождения — различаются в отчёте (AD-9).",
      "properties": {
        "device": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Подписи устройств."
        },
        "personal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Личные подписи людей (агент токена)."
        },
        "paper": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Бумажные подписи с заверением."
        },
        "partner": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Подписи партнёра (федерация)."
        },
        "server_attested": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Подписи ключами сервера (движок, шлюзы)."
        },
        "scenario": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Подписи демо-персон сценариев."
        },
        "genesis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Подписи блока генезиса."
        }
      },
      "required": [
        "device",
        "personal",
        "paper",
        "partner",
        "server_attested",
        "scenario",
        "genesis"
      ]
    },
    "paper_register": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "description": "Бумажное решение для сверки с оригиналом.",
        "properties": {
          "document_id": {
            "type": "string",
            "description": "Документ.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
          },
          "doc_digest": {
            "type": "string",
            "description": "Отпечаток.",
            "pattern": "^streebog256:[0-9a-f]{64}$"
          },
          "paper_original_no": {
            "type": "string",
            "description": "Учётный номер оригинала.",
            "maxLength": 64
          },
          "signer_person_id": {
            "type": "string",
            "description": "Подписант.",
            "maxLength": 64
          },
          "attested_by": {
            "type": "string",
            "description": "Заверитель.",
            "maxLength": 64
          },
          "scan_qr_ok": {
            "type": "boolean",
            "description": "QR со скана перечитан и совпал."
          }
        },
        "required": [
          "document_id",
          "doc_digest",
          "signer_person_id",
          "attested_by",
          "scan_qr_ok"
        ]
      },
      "description": "Реестр бумажных решений."
    }
  },
  "required": [
    "format_version",
    "crypto_profile",
    "signers",
    "verifier_build",
    "generated_at",
    "trust_anchors_digest",
    "range",
    "virtual_time",
    "verdict",
    "checks",
    "signature_classes",
    "paper_register"
  ]
}
