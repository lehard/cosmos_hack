{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/internal/stands/telemetry.v1.json",
  "title": "StandTelemetryV1",
  "description": "Сообщение stand-а оборудования (станок ЧПУ, сварочный источник, стенд) → edge-агенту (AD-18, AD-46, FR-149): отсчёты и события по классификации MTConnect. Сырые отсчёты остаются на краю; в ant уходят события и сводки на окно цикла (`equipment.*`). Закрытая схема.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "stand_id": {
      "type": "string",
      "description": "Идентификатор stand-а.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
    },
    "equipment_id": {
      "type": "string",
      "description": "Оборудование.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "description": "Прогон сценария.",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Номер сообщения stand-а."
    },
    "sent_at": {
      "type": "string",
      "description": "Доменное время сценария.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "description": "Отсчёт SAMPLE.",
        "properties": {
          "parameter": {
            "type": "string",
            "description": "Параметр.",
            "maxLength": 64
          },
          "at": {
            "type": "string",
            "description": "Время.",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "value": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Мантисса."
          },
          "scale": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12,
            "description": "Масштаб."
          },
          "unit": {
            "type": "string",
            "description": "Единица UCUM.",
            "maxLength": 32
          }
        },
        "required": [
          "parameter",
          "at",
          "value",
          "scale",
          "unit"
        ]
      },
      "description": "Отсчёты."
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "description": "Событие EVENT/CONDITION.",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "execution",
              "controller_mode",
              "condition",
              "program",
              "tool",
              "cycle",
              "alarm",
              "override"
            ],
            "description": "Категория: режим работы, режим управления, исправность, программа, инструмент, цикл, авария, коррекция режима оператором (override: value — проценты, code — что корректируется: feed, spindle, rapid, current)."
          },
          "value": {
            "type": "string",
            "description": "Значение (например, running, manual, warning, программа, инструмент).",
            "maxLength": 128
          },
          "at": {
            "type": "string",
            "description": "Время.",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "code": {
            "type": "string",
            "description": "Код.",
            "maxLength": 64
          },
          "tool_life_used": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Ресурс инструмента: сделано."
          },
          "tool_life_limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Ресурс инструмента: допустимо."
          }
        },
        "required": [
          "category",
          "value",
          "at"
        ]
      },
      "description": "События."
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "description": "Маркер цикла.",
      "properties": {
        "cycle_ref": {
          "type": "string",
          "description": "Цикл.",
          "maxLength": 128
        },
        "phase": {
          "type": "string",
          "enum": [
            "start",
            "end"
          ],
          "description": "Фаза."
        }
      },
      "required": [
        "cycle_ref",
        "phase"
      ]
    },
    "setpoints": {
      "type": "array",
      "description": "Уставки параметров выполняемой программы (задание режима: WPS сварки, запрограммированные подача и нагрузка ЧПУ) — сообщает источник в начале цикла; по ним edge-агент выделяет выход за уставку (FR-147).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "description": "Уставка параметра: номинал и границы в масштабе и единице отсчёта.",
        "properties": {
          "parameter": {
            "type": "string",
            "description": "Параметр (как в отсчётах).",
            "maxLength": 64
          },
          "nominal": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Номинал, мантисса."
          },
          "lower": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Нижняя граница, мантисса; нет — не ограничена."
          },
          "upper": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Верхняя граница, мантисса; нет — не ограничена."
          },
          "scale": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12,
            "description": "Масштаб."
          },
          "unit": {
            "type": "string",
            "description": "Единица UCUM.",
            "maxLength": 32
          }
        },
        "required": [
          "parameter",
          "scale",
          "unit"
        ]
      }
    }
  },
  "required": [
    "stand_id",
    "equipment_id",
    "seq",
    "sent_at"
  ]
}
