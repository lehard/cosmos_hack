{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/normative/locations.schema.json",
  "title": "LocationsSeed",
  "description": "Справочник мест (AD-31): normative/reference/*/locations.yaml.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999,
      "description": "Версия."
    },
    "enterprise": {
      "type": "object",
      "additionalProperties": false,
      "description": "Предприятие.",
      "properties": {
        "code": {
          "type": "string",
          "description": "Код.",
          "pattern": "^[A-Z0-9][A-Z0-9_-]{0,15}$"
        },
        "name": {
          "type": "string",
          "description": "Название.",
          "maxLength": 256
        }
      },
      "required": [
        "code",
        "name"
      ]
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "description": "Место.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "building",
              "workshop",
              "line",
              "station",
              "workplace",
              "warehouse",
              "isolator",
              "storage"
            ],
            "description": "Вид."
          },
          "scope": {
            "type": "string",
            "description": "Область политики.",
            "pattern": "^[a-z0-9_-]+(/[a-z0-9_-]+)*$"
          },
          "parent": {
            "type": "string",
            "description": "Родитель.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
          },
          "name": {
            "type": "string",
            "description": "Название.",
            "maxLength": 256
          },
          "lane_id": {
            "type": "string",
            "description": "Дорожка BPMN (для цеха).",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "warehouse_id": {
            "type": "string",
            "description": "Склад цеха.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
          },
          "access_zone_id": {
            "type": "string",
            "description": "Зона СКУД.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
          }
        },
        "required": [
          "id",
          "kind",
          "scope",
          "name"
        ]
      },
      "description": "Места.",
      "minItems": 1
    }
  },
  "required": [
    "version",
    "enterprise",
    "locations"
  ]
}
