{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/normative/equipment.schema.json",
  "title": "EquipmentSeed",
  "description": "Оборудование и поверка (AD-31, FR-17): normative/reference/*/equipment.yaml.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999,
      "description": "Версия."
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "description": "Оборудование.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "cnc_machine",
              "welding_source",
              "camera",
              "cmm",
              "leak_tester",
              "torque_wrench",
              "xray",
              "test_bench",
              "other"
            ],
            "description": "Вид."
          },
          "location_id": {
            "type": "string",
            "description": "Место.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
          },
          "name": {
            "type": "string",
            "description": "Название.",
            "maxLength": 256
          },
          "measuring": {
            "type": "boolean",
            "description": "Средство измерений."
          },
          "source_id": {
            "type": "string",
            "description": "Источник событий.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
          },
          "setpoints": {
            "type": "object",
            "description": "Уставки параметров (целые в базовой единице параметра).",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "description": "Уставка.",
              "properties": {
                "nominal": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Номинал."
                },
                "lower": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Нижняя граница."
                },
                "upper": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Верхняя граница."
                }
              },
              "required": [
                "nominal",
                "lower",
                "upper"
              ]
            }
          }
        },
        "required": [
          "id",
          "kind",
          "location_id",
          "name",
          "measuring"
        ]
      },
      "description": "Оборудование.",
      "minItems": 1
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "description": "Поверка или калибровка.",
        "properties": {
          "equipment_id": {
            "type": "string",
            "description": "Оборудование.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "verification",
              "calibration"
            ],
            "description": "Вид."
          },
          "result": {
            "type": "string",
            "enum": [
              "valid",
              "invalid"
            ],
            "description": "Итог."
          },
          "valid_until": {
            "type": "string",
            "description": "До.",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "certificate_ref": {
            "type": "string",
            "description": "Свидетельство.",
            "maxLength": 128
          }
        },
        "required": [
          "equipment_id",
          "kind",
          "result",
          "valid_until"
        ]
      },
      "description": "Поверки."
    }
  },
  "required": [
    "version",
    "equipment",
    "verifications"
  ]
}
