{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/normative/analyzer-passports.schema.json",
  "title": "AnalyzerPassportsSeed",
  "description": "Стартовые паспорта допуска анализаторов для демо (normative/vision/analyzer-passports.v*.yaml; эпик 33, AD-29, AD-33): записи analyzer.passport.admitted, которые роль migrate пишет генезисом в профилях demo и fixtures. Это не допуск по экзамену (полный маршрут — эпик 40): паспорт помечен происхождением genesis.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999,
      "description": "Версия затравки: входит в event_id записей (повтор той же версии — дубль, а не вторая запись)."
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["demo", "fixtures", "load"],
        "description": "Профиль окружения."
      },
      "description": "Профили, в которых паспорта записываются; в prod затравка не пишется никогда."
    },
    "admitted_at": {
      "type": "string",
      "description": "occurred_at записей допуска: раньше любого наблюдения демо.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "note": {
      "type": "string",
      "maxLength": 1000,
      "description": "Пометка для людей: демо-затравка, не промышленная валидация."
    },
    "passports": {
      "type": "array",
      "minItems": 1,
      "description": "Паспорта допуска.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "description": "Паспорт допуска карты контроля.",
        "properties": {
          "passport_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$",
            "description": "Паспорт."
          },
          "analyzer_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$",
            "description": "Анализатор."
          },
          "analyzer_kind": {
            "type": "string",
            "enum": ["visionqc", "operatorvision"],
            "description": "Визуальный контроль или контроль действий оператора."
          },
          "title": {
            "type": "string",
            "maxLength": 256,
            "description": "Название анализатора."
          },
          "stage": {
            "type": "string",
            "enum": ["shadow", "pilot", "active"],
            "description": "Стадия допуска."
          },
          "trust_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4,
            "description": "Уровень доверия (contracts/analyzer-trust-levels.yaml)."
          },
          "recipe_ref": {
            "type": "string",
            "maxLength": 128,
            "description": "Карта контроля `‹id›@‹версия›` — как в ant:inspection/@recipeRef процесса."
          },
          "document_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$",
            "description": "Протокол допуска (для затравки — условный номер демо)."
          },
          "versions": {
            "type": "object",
            "additionalProperties": false,
            "description": "Допущенная конфигурация контура — все восемь составляющих вектора версий (AD-29).",
            "properties": {
              "item_revision": {"type": "string", "maxLength": 64, "description": "Ревизия изделия (КД)."},
              "recipe_ref": {"type": "string", "maxLength": 128, "description": "Карта контроля с версией."},
              "camera_config": {"type": "string", "maxLength": 128, "description": "Конфигурация камеры и света."},
              "calibration": {"type": "string", "maxLength": 128, "description": "Калибровка."},
              "analyzer_version": {"type": "string", "maxLength": 128, "description": "Версия анализатора."},
              "threshold_profile": {"type": "string", "maxLength": 128, "description": "Профиль порогов."},
              "contract_version": {"type": "string", "maxLength": 64, "description": "Версия контракта данных источника."},
              "app_version": {"type": "string", "maxLength": 64, "description": "Версия приложения источника."}
            },
            "required": ["item_revision", "recipe_ref", "camera_config", "calibration", "analyzer_version", "threshold_profile", "contract_version", "app_version"]
          }
        },
        "required": ["passport_id", "analyzer_id", "analyzer_kind", "title", "stage", "trust_level", "recipe_ref", "document_id", "versions"]
      }
    }
  },
  "required": ["version", "profiles", "admitted_at", "passports"]
}
