{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/normative/calendar.schema.json",
  "title": "CalendarSeed",
  "description": "Производственный календарь (FR-55): normative/reference/*/calendar.yaml.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999,
      "description": "Версия."
    },
    "calendar_id": {
      "type": "string",
      "description": "Календарь.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
    },
    "time_zone": {
      "type": "string",
      "description": "Часовой пояс IANA.",
      "maxLength": 64
    },
    "years": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "description": "Год.",
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2100,
            "description": "Год."
          },
          "weekly_days_off": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "mon",
                "tue",
                "wed",
                "thu",
                "fri",
                "sat",
                "sun"
              ],
              "description": "День недели."
            },
            "description": "Еженедельные выходные.",
            "uniqueItems": true
          },
          "holidays": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Дата.",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "description": "Праздники.",
            "uniqueItems": true
          },
          "shortened_days": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Дата.",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "description": "Сокращённые дни.",
            "uniqueItems": true
          }
        },
        "required": [
          "year",
          "weekly_days_off",
          "holidays",
          "shortened_days"
        ]
      },
      "description": "Годы.",
      "minItems": 1
    }
  },
  "required": [
    "version",
    "calendar_id",
    "time_zone",
    "years"
  ]
}
