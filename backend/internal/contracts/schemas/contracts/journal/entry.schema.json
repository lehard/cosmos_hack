{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ant.invalid/contracts/journal/entry.schema.json",
  "title": "JournalEntry",
  "description": "Запись журнала v1 (AD-44): открытый заголовок (маршрутизация, время, тип, изделие, правило, слот, обязательство и звено) и зашифрованный блок с исходным конвертом DSSE и salt (AD-23). Go-типы генерируются и используются всеми, включая верификатор. Формат цепочки — chain-format.v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seq",
    "chain",
    "entry_kind",
    "event_type",
    "schema_version",
    "event_id",
    "source_id",
    "stream",
    "partition",
    "occurred_at",
    "received_at",
    "recorded_at",
    "committed_at",
    "correlation_id",
    "causation_id",
    "provenance_class",
    "domain_build",
    "commit",
    "link",
    "sealed"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Позиция в своей цепочке (`chain`): порядок знания (AD-37); для ca — номер CA-‹n›."
    },
    "chain": {
      "type": "string",
      "enum": [
        "main",
        "ca"
      ],
      "description": "Цепочка: основной журнал или журнал критических действий (AD-8)."
    },
    "entry_kind": {
      "type": "string",
      "enum": [
        "fact",
        "reaction",
        "decision",
        "service"
      ],
      "description": "Вид записи (AD-2); совпадает с каталогом для event_type."
    },
    "event_type": {
      "type": "string",
      "description": "Тип записи из catalog.yaml.",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999,
      "description": "Мажорная версия схемы data в исходном конверте (повышатели применяются при чтении, AD-20)."
    },
    "event_id": {
      "type": "string",
      "description": "event_id из конверта: UUIDv7; у реакций, производных и событий сценария — UUIDv5.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_id": {
      "type": "string",
      "description": "Источник.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
    },
    "source_seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Номер у источника."
    },
    "run_id": {
      "type": "string",
      "description": "Прогон сценария (AD-38).",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "item_id": {
      "type": "string",
      "description": "Внутренний ID изделия — только внутренний (AD-41).",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{0,15}:[A-Za-z0-9][A-Za-z0-9._/-]{0,95}$"
    },
    "carrier_ref": {
      "type": "string",
      "description": "Значение носителя из item_ref источника: `‹тип›:‹значение›` (AD-41).",
      "maxLength": 300
    },
    "stream": {
      "type": "string",
      "description": "Поток (AD-39): `item:‹item_id›`, `‹вид›:‹id›` или `global`.",
      "pattern": "^(global|[a-z_]+:[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127})$"
    },
    "partition": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "Партиция: hash(item_id) mod P; для записей вне изделия — партиция стадии."
    },
    "occurred_at": {
      "type": "string",
      "description": "Время возникновения (из конверта; для решений и реакций ставит ядро, AD-37).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "received_at": {
      "type": "string",
      "description": "Время поступления в приём — ставит только ядро.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "recorded_at": {
      "type": "string",
      "description": "Доменное время записи (DomainClock), не убывает по seq (AD-37).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "committed_at": {
      "type": "string",
      "description": "Реальное время фиксации (InfraClock), не убывает по seq, покрыто контрольными точками.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "correlation_id": {
      "type": "string",
      "description": "Сквозная цепочка.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Непосредственная причина; null у корневой записи."
    },
    "rule_id": {
      "type": "string",
      "description": "Правило реакции (AD-3).",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
    },
    "normative_rev": {
      "type": "string",
      "description": "Ревизия нормативного слоя, по которой исполнено (хеш версии процесса или номер).",
      "maxLength": 128
    },
    "reaction_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "subject",
        "trigger_key"
      ],
      "description": "Слот реакции (AD-3).",
      "properties": {
        "rule_id": {
          "type": "string",
          "description": "Правило.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
        },
        "subject": {
          "type": "string",
          "description": "Субъект — поток.",
          "pattern": "^(global|[a-z_]+:[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127})$"
        },
        "trigger_key": {
          "type": "string",
          "description": "Ключ срабатывания.",
          "maxLength": 256
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Версия слота реакции."
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Заменяемая версия слота."
    },
    "basis_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Реакции — основание пачки; решения — позиция журнала, на которой проверен гард (AD-39)."
    },
    "policy_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Ревизия политики доступа, по которой проверена команда (AD-39)."
    },
    "provenance_class": {
      "type": "string",
      "enum": [
        "device",
        "personal",
        "paper",
        "partner",
        "server_attested",
        "scenario",
        "genesis"
      ],
      "description": "Класс происхождения подписи (AD-2)."
    },
    "domain_build": {
      "type": "string",
      "description": "Хеш доменного пакета, свернувшего запись (AD-9).",
      "pattern": "^streebog256:[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "description": "Обязательство: H(salt ‖ JCS(конверт DSSE)) (AD-23, AD-44).",
      "pattern": "^streebog256:[0-9a-f]{64}$"
    },
    "link": {
      "type": "string",
      "description": "Звено: H(prev_link ‖ commit ‖ H(JCS(открытые поля без link))) (AD-44).",
      "pattern": "^streebog256:[0-9a-f]{64}$"
    },
    "sealed": {
      "$ref": "#/definitions/sealed_block"
    }
  },
  "definitions": {
    "sealed_block": {
      "type": "object",
      "additionalProperties": false,
      "description": "Зашифрованный блок (AD-23): AEAD над JCS(plain_block); доп. данные — chain ‖ seq ‖ commit.",
      "required": [
        "aead",
        "dek_id",
        "nonce_b64",
        "ciphertext_b64"
      ],
      "properties": {
        "aead": {
          "type": "string",
          "enum": [
            "kuznyechik_mgm",
            "aes_256_gcm"
          ],
          "description": "Алгоритм AEAD: «Кузнечик»-MGM (ГОСТ) или AES-256-GCM."
        },
        "dek_id": {
          "type": "string",
          "description": "Ключ шифрования данных; обёртки — journal.dek_wraps.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "nonce_b64": {
          "type": "string",
          "description": "Нонс.",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "ciphertext_b64": {
          "type": "string",
          "description": "Шифротекст с тегом.",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        }
      }
    },
    "plain_block": {
      "type": "object",
      "additionalProperties": false,
      "description": "Содержимое после расшифрования; после него всегда проверяется commit.",
      "required": [
        "salt_b64",
        "envelope"
      ],
      "properties": {
        "salt_b64": {
          "type": "string",
          "description": "128 случайных бит на запись.",
          "pattern": "^[A-Za-z0-9+/]{22}==$"
        },
        "envelope": {
          "$ref": "../crypto/dsse-envelope.schema.json"
        }
      }
    }
  }
}
