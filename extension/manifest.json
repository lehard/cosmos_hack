{
  "manifest_version": 3,
  "name": "Главный — подпись",
  "short_name": "Главный",
  "version": "0.1.0",
  "description": "Подпись решений системы «Главный» ключом человека: ключ в браузере под PIN или физический ключ через агент токена (AD-14, Д-72).",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Главный — подпись",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "manage.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "idle",
    "alarms",
    "nativeMessaging",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "128": "icon128.png"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
